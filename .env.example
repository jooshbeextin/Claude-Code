# ─────────────────────────────────────────────────────────────
# Daily Executive Report — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. Never commit .env to git
# ─────────────────────────────────────────────────────────────

# REQUIRED — Anthropic API Key
# Get yours at: https://console.anthropic.com/
# Free tier available; Opus 4.6 used for best report quality.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL — Gmail App Password (for email delivery)
# Steps to get one (completely free):
#   1. Sign in to your Google account
#   2. Go to: myaccount.google.com → Security
#   3. Enable 2-Step Verification (if not already on)
#   4. Search for "App passwords" in the Security page
#   5. Create an App Password → select app: Mail, device: Other (type "Daily Report")
#   6. Copy the 16-character password below (no spaces)
#   7. Also fill in sender_email and recipient_email in config.yaml
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
