# ─────────────────────────────────────────────────────────────
# Daily Executive Report — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values
# 3. Never commit .env to git
# ─────────────────────────────────────────────────────────────

# REQUIRED — Anthropic API Key
# Get yours free at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────
# TELEGRAM — Free, 2-minute setup
# ─────────────────────────────────────────────────────────────
# Step 1: Open Telegram, search for @BotFather, send: /newbot
# Step 2: Follow prompts — give your bot a name and username
# Step 3: BotFather gives you a token (looks like: 123456:ABCdef...)
# Step 4: Start a chat with your new bot (search it, press Start)
# Step 5: Open this URL in your browser (replace YOUR_TOKEN):
#           https://api.telegram.org/botYOUR_TOKEN/getUpdates
#         Find "chat": {"id": 123456789} — that's your chat ID
# Step 6: Fill in both values below
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
